# Application
NODE_ENV=development
PORT=4001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=0000
DB_NAME=education_crm

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# TypeORM (set false in production — use migrations)
DB_SYNCHRONIZE=true
